{
  "name": "make-a-baseball-team",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Offline, single-file KBO expansion club management game",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node tests/browser/smoke.mjs",
    "port:draftroom": "python3 scripts/port-draftroom.py",
    "golden:write": "tsx scripts/write-league-golden.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "report": "tsx scripts/league-report.ts"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.4",
    "fake-indexeddb": "^6.2.5",
    "playwright-core": "1.56.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.1"
  }
}
